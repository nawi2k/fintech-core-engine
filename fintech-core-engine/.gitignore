@'
# Dependencias
node_modules/
**/node_modules/

# Entorno y credenciales
.env
.env.*
!.env.example

# Compilación y TypeScript
dist/
build/
*.js
*.js.map
!jest.config.js
!prisma.config.ts

# Cobertura de tests
coverage/

# Logs y bases de datos locales
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.sqlite
*.sqlite-journal

# Sistema operativo
.DS_Store
Thumbs.db
'@ | Set-Content -Path ".\.gitignore" -Encoding UTF8